	{ "command": "add_where_snippet", "args": {"snippet": "<open files>"}, "caption": "Agregar archivos abiertos" },
	{ "command": "add_where_snippet", "args": {"snippet": "<current file>"}, "caption": "Agregar archivo actual" },
