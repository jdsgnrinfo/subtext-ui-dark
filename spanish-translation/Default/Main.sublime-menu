			{ "command": "auto_complete", "caption": "Mostrar autocompletado" },
			{ "caption": "-", "id": "permute" },

			{ "command": "sort_lines", "args": {"case_sensitive": false}, "caption": "Ordenar líneas", "mnemonic": "S" },
			{ "command": "sort_lines", "args": {"case_sensitive": true}, "caption": "Ordenar líneas (distingue mayúsculas)" },
			{
				"caption": "Permutar líneas",
				"children":
				[
					{ "command": "permute_lines", "args": {"operation": "reverse"}, "caption": "Invertir" },
					{ "command": "permute_lines", "args": {"operation": "unique"}, "caption": "Únicas" },
					{ "command": "permute_lines", "args": {"operation": "shuffle"}, "caption": "Mezclar" }
				]
			},
			{
				"caption": "Permutar selecciones",
				"children":
				[
					{ "command": "sort_selection", "args": {"case_sensitive": false}, "caption": "Ordenar" },
					{ "command": "sort_selection", "args": {"case_sensitive": true}, "caption": "Ordenar (distingue mayúsculas)" },
					{ "command": "permute_selection", "args": {"operation": "reverse"}, "caption": "Invertir" },
					{ "command": "permute_selection", "args": {"operation": "unique"}, "caption": "Únicas" },
					{ "command": "permute_selection", "args": {"operation": "shuffle"}, "caption": "Mezclar" }
