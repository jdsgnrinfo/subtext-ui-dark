			{ "command": "show_license_window", "caption": "Ingresar licencia" },
			{ "command": "remove_license"},
			{ "caption": "-" },
			{ "command": "update_check", "caption": "Buscar actualizaciones…" },
			{ "command": "show_changelog", "caption": "Registro de cambios…" },
			{ "command": "show_attribution", "caption": "Licencias y atribuciones…" },
			{ "command": "show_about_window", "caption": "Acerca de Sublime Text", "mnemonic": "A" }
