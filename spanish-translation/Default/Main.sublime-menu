	{
		"caption": "Edición",
		"mnemonic": "E",
		"id": "edit",
		"children":
		[
			{ "command": "undo", "mnemonic": "U" },
			{ "command": "redo_or_repeat", "mnemonic": "R" },
			{
				"caption": "Deshacer selección",
				"children":
				[
					{ "command": "soft_undo" },
					{ "command": "soft_redo" }
				]
			},
			{ "caption": "-", "id": "clipboard" },
			{ "command": "cut", "mnemonic": "t" },
			{ "command": "copy", "mnemonic": "C" },
			{ "caption": "Copiar como HTML", "command": "copy_as_html", "args": {"enclosing_tags": true, "font_size": false} },
			{ "command": "paste", "mnemonic": "P" },
			{ "command": "paste_and_indent", "mnemonic": "I" },
			{ "command": "paste_from_history", "caption": "Pegar desde el historial" },
			{ "caption": "-" },
			{
				"caption": "Línea", "mnemonic": "L",
				"id": "line",
				"children":
				[
					{ "command": "indent" },
					{ "command": "unindent" },
					{ "command": "reindent", "args": {"single_line": true} },
					{ "command": "swap_line_up" },
					{ "command": "swap_line_down" },
					{ "command": "duplicate_line" },
					{ "command": "run_macro_file", "args": {"file": "res://Packages/Default/Delete Line.sublime-macro"}, "caption": "Eliminar línea" },
					{ "command": "join_lines" }
				]
			},
			{
				"caption": "Comentario", "mnemonic": "m",
				"id": "comment",
				"children":
				[
					{ "command": "toggle_comment", "args": {"block": false}, "caption": "Alternar comentario" },
					{ "command": "toggle_comment", "args": {"block": true}, "caption": "Alternar comentario de bloque" }
				]
			},
			{
				"caption": "Texto", "mnemonic": "T",
				"id": "text",
				"children":
				[
					{ "command": "revert_hunk" },
					{ "command": "revert_modification" },
					{ "command": "toggle_inline_diff" },
					{ "caption": "-" },
					{ "command": "run_macro_file", "args": {"file": "res://Packages/Default/Add Line Before.sublime-macro"}, "caption": "Insertar línea antes" },
					{ "command": "run_macro_file", "args": {"file": "res://Packages/Default/Add Line.sublime-macro"}, "caption": "Insertar línea después" },
					{ "caption": "-" },
					{ "command": "delete_word", "args": { "forward": true }, "caption": "Eliminar palabra hacia adelante" },
					{ "command": "delete_word", "args": { "forward": false }, "caption": "Eliminar palabra hacia atrás" },
					{ "command": "run_macro_file", "args": {"file": "res://Packages/Default/Delete Line.sublime-macro"}, "caption": "Eliminar línea" },
					{ "command": "run_macro_file", "args": {"file": "res://Packages/Default/Delete to Hard EOL.sublime-macro"}, "caption": "Eliminar hasta el final" },
					{ "command": "run_macro_file", "args": {"file": "res://Packages/Default/Delete to Hard BOL.sublime-macro"}, "caption": "Eliminar hasta el inicio" },
					{ "caption": "-" },
					{ "command": "transpose" }
				]
			},
			{
				"caption": "Etiqueta",
				"id": "tag",
				"children":
				[
					{ "command": "close_tag" },
					{ "command": "expand_selection", "args": {"to": "tag"}, "caption": "Expandir selección a la etiqueta" },
					{ "command": "insert_snippet", "args": { "name": "Packages/XML/Snippets/xml-long-tag.sublime-snippet" }, "caption": "Envolver selección con etiqueta" }
				]
			},
			{
				"caption": "Marca",
				"id": "mark",
				"children":
				[
					{ "command": "set_mark" },
					{ "command": "select_to_mark", "caption": "Seleccionar hasta la marca" },
					{ "command": "delete_to_mark", "caption": "Eliminar hasta la marca" },
					{ "command": "swap_with_mark", "caption": "Intercambiar con la marca" },
					{ "command": "clear_bookmarks", "args": {"name": "mark"}, "caption": "Quitar marca" },
					{ "caption": "-" },
					{ "command": "yank" }
				]
			},
			{
				"caption": "Plegado de código",
				"id": "fold",
				"children":
				[
					{ "command": "fold" },
					{ "command": "unfold" },
					{ "command": "unfold_all", "caption": "Desplegar todo" },
					{ "caption": "-" },
					{ "caption": "Plegar todo", "command": "fold_by_level", "mnemonic": "A", "args": {"level": 1} },
					{ "caption": "Plegar nivel 2", "command": "fold_by_level", "mnemonic": "2", "args": {"level": 2} },
					{ "caption": "Plegar nivel 3", "command": "fold_by_level", "mnemonic": "3", "args": {"level": 3} },
					{ "caption": "Plegar nivel 4", "command": "fold_by_level", "mnemonic": "4", "args": {"level": 4} },
					{ "caption": "Plegar nivel 5", "command": "fold_by_level", "mnemonic": "5", "args": {"level": 5} },
					{ "caption": "Plegar nivel 6", "command": "fold_by_level", "mnemonic": "6", "args": {"level": 6} },
					{ "caption": "Plegar nivel 7", "command": "fold_by_level", "mnemonic": "7", "args": {"level": 7} },
					{ "caption": "Plegar nivel 8", "command": "fold_by_level", "mnemonic": "8", "args": {"level": 8} },
					{ "caption": "Plegar nivel 9", "command": "fold_by_level", "mnemonic": "9", "args": {"level": 9} },
					{ "caption": "-" },
					{ "command": "fold_tag_attributes", "caption": "Plegar atributos de etiqueta" }
				]
			},
			{
				"caption": "Convertir mayúsculas/minúsculas", "mnemonic": "a",
				"id": "convert_case",
				"children":
				[
					{ "command": "title_case", "caption": "Tipo Título" },
					{ "command": "upper_case", "caption": "MAYÚSCULAS" },
					{ "command": "lower_case", "caption": "Minúsculas" },
					{ "command": "swap_case", "caption": "Invertir mayúsculas/minúsculas" },
					{ "command": "convert_ident_case", "caption": "lowerCamelCase", "args": {"case": "title", "first_case": "lower"} },
					{ "command": "convert_ident_case", "caption": "UpperCamelCase", "args": {"case": "title"} },
					{ "command": "convert_ident_case", "caption": "snake_case", "args": {"separator": "_", "case": "lower"} },
					{ "command": "convert_ident_case", "caption": "kebab-case", "args": {"separator": "-", "case": "lower"} },
				]
			},
			{
				"caption": "Ajustar",
				"id": "wrap",
				"children":
				[
					{ "command": "wrap_lines", "caption": "Ajustar párrafo" },
